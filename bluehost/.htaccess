# The Beaute Bungalow — static site (Bluehost / Apache)
# Copied into the site root (out/.htaccess) by the Bluehost deploy workflow.

# Serve the exported custom 404 page
ErrorDocument 404 /404.html

# Compress text assets
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>

# Cache fingerprinted static assets (HTML is intentionally NOT cached,
# so content updates go live immediately on the next deploy)
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/png              "access plus 30 days"
  ExpiresByType image/jpeg             "access plus 30 days"
  ExpiresByType image/x-icon           "access plus 30 days"
  ExpiresByType image/svg+xml          "access plus 30 days"
  ExpiresByType text/css               "access plus 7 days"
  ExpiresByType application/javascript "access plus 7 days"
</IfModule>
